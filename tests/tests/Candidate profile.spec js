    const safeStep = async (stepName, fn) => {
        console.log(`\n========== ${stepName} ==========`);
        try {
            await fn();
            console.log(`✅ PASSED: ${stepName}`);
        } catch (e) {
            console.log(`⚠️ FAILED BUT CONTINUING: ${stepName}`);
